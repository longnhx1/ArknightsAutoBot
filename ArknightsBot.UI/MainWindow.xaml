<Window x:Class="ArknightsBot.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        mc:Ignorable="d"
        Title="Arknights Auto Bot Pro v1.0" Height="800" Width="1150"
        WindowStartupLocation="CenterScreen"
        Background="#0F0F11" Foreground="#E2E8F0"
        FontFamily="Segoe UI"
        Icon="icon.png">

    <Window.Resources>
        <!-- Thêm styles cao cấp -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#17171A"/>
            <Setter Property="BorderBrush" Value="#25252B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24"/>
        </Style>

        <!-- Accent color: Arknights Yellow/Gold -->
        <SolidColorBrush x:Key="AccentBrush" Color="#FACC15"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#EAB308"/>

        <!-- Label Style -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="0,5,5,5"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <!-- Modern TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0A0A0C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button Style (Primary) -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#0F0F11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CA8A04"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Start Button -->
        <Style x:Key="StartButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#22C55E"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#16A34A"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#27272A"/>
                    <Setter Property="Foreground" Value="#52525B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Stop Button -->
        <Style x:Key="StopButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DC2626"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#27272A"/>
                    <Setter Property="Foreground" Value="#52525B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3F3F46"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#0A0A0C" BorderBrush="#1C1C21" BorderThickness="0,0,0,1">
            <Grid Margin="30,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Icon placeholder / Logo -->
                    <Path Data="M 0 10 L 10 0 L 20 10 L 10 20 Z" Fill="{StaticResource AccentBrush}" Width="20" Height="20" Stretch="Fill" Margin="0,0,15,0"/>
                    <TextBlock Text="RHODES ISLAND" FontSize="22" FontWeight="Black" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text=" AUTO BOT PRO" FontSize="22" FontWeight="Light" Foreground="White" VerticalAlignment="Center" Opacity="0.8"/>
                </StackPanel>
                
                <TextBlock Text="Status: Standby" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="14" FontWeight="Medium"/>
            </Grid>
        </Border>

        <!-- MAIN LAYOUT -->
        <Grid Grid.Row="1" Margin="30,25,30,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="25"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="25"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TASK SELECTION CARD -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="TASK SELECTION" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,20"/>
                        
                        <!-- Custom Task Item 1 -->
                        <Border Background="#202024" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="chkAutoExit" Grid.Column="0" IsChecked="True"/>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Auto Exit Loop" Foreground="White" FontWeight="Bold" FontSize="15"/>
                                    <TextBlock Text="Tự động thoát sau khi hết thể lực" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="#1C1C1E" CornerRadius="8" Padding="15" Margin="0,0,0,10" Opacity="0.5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="chkAutoRecruit" Grid.Column="0" IsEnabled="False"/>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Auto Recruit" Foreground="White" FontWeight="Bold" FontSize="15"/>
                                    <TextBlock Text="Tự động tuyển dụng (Sắp ra mắt)" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        
                        <Border Background="#1C1C1E" CornerRadius="8" Padding="15" Opacity="0.5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsEnabled="False"/>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Auto I.S" Foreground="White" FontWeight="Bold" FontSize="15"/>
                                    <TextBlock Text="Tự động chạy sự kiện (Sắp ra mắt)" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- CONTROL PANEL -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="OPERATION CONTROL" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,20" Grid.Row="0"/>
                        
                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <Button x:Name="btnStart" Content="START OPERATION" Style="{StaticResource StartButton}" Height="55" Margin="0,0,0,15" Click="BtnStart_Click" FontSize="16" FontWeight="Black"/>
                            <Button x:Name="btnStop" Content="EMERGENCY STOP" Style="{StaticResource StopButton}" Height="55" Click="BtnStop_Click" FontSize="16" FontWeight="Black" IsEnabled="False"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- MIDDLE: SYSTEM CONFIGURATION -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="SYSTEM CONFIGURATION" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,20" Grid.Row="0"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,15,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <Label Content="Game Region"/>
                                        <ComboBox x:Name="cboRegion" SelectedIndex="0" Height="42" FontSize="14" Background="#0A0A0C" Foreground="White" BorderBrush="#27272A" Padding="12,10">
                                            <ComboBoxItem Content="EN (Global)"/>
                                            <ComboBoxItem Content="JP (Japan)"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Label Content="ADB Connection Address"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtAdbAddress" Grid.Column="0" Text="127.0.0.1:16384" hc:InfoElement.Placeholder="VD: 127.0.0.1:7555"/>
                                            <Button x:Name="btnAutoDetect" Grid.Column="1" Content="Auto" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Width="60" Click="BtnAutoDetectAdb_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <Label Content="MuMu Root Folder (Cho Enhanced Mode)"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtMumuPath" Grid.Column="0" Text="D:\Program Files\MuMuPlayer-12.0" hc:InfoElement.Placeholder="Chọn thư mục MuMu..."/>
                                    <Button x:Name="btnBrowseMumu" Grid.Column="1" Content="Browse" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Width="90" Click="BtnBrowseMumu_Click"/>
                                </Grid>

                                <StackPanel Orientation="Vertical" Margin="0,5,0,25">
                                    <CheckBox x:Name="chkEnhancedMode" Content="Enable Screenshot Enhancement (Siêu tốc)" IsChecked="True" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="15"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="chkDebugMode" Grid.Column="0" Content="Developer Debug Mode (Hiển thị Sim &amp; Sleep)" IsChecked="False" Foreground="#94A3B8" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="2" Text="Delay (s):" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBox x:Name="numDebugDelay" Grid.Column="3" Text="1" Padding="5"/>
                                    </Grid>
                                </StackPanel>

                                <Rectangle Fill="#25252B" Height="1" Margin="0,0,0,25"/>

                                <TextBlock Text="DELAY SETTINGS (SECONDS)" Foreground="#94A3B8" FontWeight="Bold" Margin="0,0,0,15" FontSize="13"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="15"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="15"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Left Column -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Visibility="Collapsed">
                                        <Label Content="Delay Start (Click Green)"/>
                                        <TextBox x:Name="numStart" Text="2"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <Label Content="Delay Settings (Click Gear)"/>
                                        <TextBox x:Name="numSettings" Text="0.5"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="4" Grid.Column="0">
                                        <Label Content="Delay Confirm"/>
                                        <TextBox x:Name="numConfirm" Text="0.2"/>
                                    </StackPanel>

                                    <!-- Right Column -->
                                    <StackPanel Grid.Row="0" Grid.Column="2" Visibility="Collapsed">
                                        <Label Content="Delay Squad (Click Red)"/>
                                        <TextBox x:Name="numSquad" Text="1"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <Label Content="Delay Retreat"/>
                                        <TextBox x:Name="numRetreat" Text="0.2"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Actions -->
                        <Border Grid.Row="2" BorderBrush="#25252B" BorderThickness="0,1,0,0" Padding="0,20,0,0" Margin="0,10,0,0">
                            <Button x:Name="btnSave" Content="SAVE CONFIGURATION" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Width="220" Click="BtnSave_Click"/>
                        </Border>
                    </Grid>
                </Border>

            <!-- RIGHT: TERMINAL LOGS -->
            <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="15">
                <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Text="TERMINAL LOGS" FontSize="13" FontWeight="Bold" Foreground="#64748B" Margin="5,0,0,10" Grid.Row="0"/>
                        
                        <Border Grid.Row="1" Background="#050505" CornerRadius="6" BorderBrush="#1C1C21" BorderThickness="1" Padding="12">
                            <ScrollViewer x:Name="scrollViewerLogs" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="txtLogs" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" Foreground="#A3A3A3" LineHeight="20">
                                    <Run Foreground="#22C55E" Text="[SYSTEM] PRTS terminal initialized."/><LineBreak/>
                                    <Run Foreground="#EAB308" Text="[SYSTEM] Standing by for instructions..."/><LineBreak/>
                                </TextBlock>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
        </Grid>
    </Grid>
</Window>